# Django Core Settings
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web,your-dokploy-domain.com

# Dokploy / Traefik SSL & CSRF Settings
# Comma-separated list of your full HTTPS domain URLs
CSRF_TRUSTED_ORIGINS=https://your-dokploy-domain.com,https://easyeats.yourdomain.com

# Database Configuration (PostgreSQL on Dokploy or external)
DATABASE_URL=postgres://breakfast_user:breakfast_pass@db:5432/breakfast_db

# Initial Superuser Credentials (auto-created on first boot)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-secure-password

# Optional: PostgreSQL container variables if deploying via Docker Compose
POSTGRES_DB=breakfast_db
POSTGRES_USER=breakfast_user
POSTGRES_PASSWORD=breakfast_pass
POSTGRES_PORT=5432
